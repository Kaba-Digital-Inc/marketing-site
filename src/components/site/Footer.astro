---
import { site } from "@/lib/site";
import { getVisibleProjects } from "@/lib/projects";
const projects = await getVisibleProjects();
const year = new Date().getFullYear();

const groups: { title: string; links: { label: string; href: string }[] }[] = [
  {
    title: "Who we help",
    links: [
      { label: "Startups", href: "/startups/" },
      { label: "Small business", href: "/ai-native/" },
      { label: "Enterprise", href: "/enterprise/" },
      { label: "Investors", href: "/investors/" },
    ],
  },
  {
    title: "Services",
    links: [
      { label: "AI agent development", href: "/services/ai-agent-development/" },
      { label: "AI automation", href: "/services/ai-automation/" },
      { label: "AI workshops", href: "/services/ai-workshops/" },
      { label: "Agents on Cloudflare", href: "/cloudflare/" },
      { label: "All services", href: "/services/" },
    ],
  },
  {
    title: "Work and learn",
    links: [
      ...projects.map((p) => ({ label: p.data.title, href: `/work/${p.id}/` })),
      { label: "All work", href: "/work/" },
      { label: "Insights", href: "/insights/" },
      { label: "Our technology", href: "/stack/" },
      { label: "Partners", href: "/partners/" },
    ],
  },
  {
    title: "Company",
    links: [
      { label: "About", href: "/about/" },
      { label: "Locations", href: "/locations/" },
      { label: "Contact", href: "/contact/" },
    ],
  },
];
const link = "inline-flex min-h-[40px] items-center text-chalk-soft transition-colors hover:text-chalk lg:min-h-[30px]";
---

<footer class="border-t border-line bg-panel">
  <div class="shell py-14 lg:py-16">
    <div class="grid gap-12 lg:grid-cols-[1.35fr_2.65fr] lg:gap-16">
      <div>
        <div class="flex items-center gap-2.5">
          <svg viewBox="0 0 28 28" class="h-7 w-7" aria-hidden="true">
            <rect x="1" y="1" width="26" height="26" rx="7" fill="#0e1012" stroke="#262b31" />
            <circle cx="9.5" cy="9.5" r="2.4" fill="#f2f4f6"></circle>
            <circle cx="18.5" cy="14" r="2.4" fill="#35d6f5"></circle>
            <circle cx="9.5" cy="18.5" r="2.4" fill="#f2f4f6"></circle>
            <path d="M11.4 10.6 16.6 12.9M11.4 17.4 16.6 15.1" stroke="#f2f4f6" stroke-width="1.1" opacity="0.5"></path>
          </svg>
          <span class="font-display text-[17px] font-semibold tracking-tight">{site.name}</span>
        </div>
        <p class="mt-5 max-w-xs text-[15px] leading-relaxed text-chalk-mute">
          An AI engineering studio in Toronto. We build and run AI agents and automation, run hands-on AI labs for teams, and partner with selected startups.
        </p>
        <ul class="mt-5 space-y-1 text-[15px]">
          <li><a href={`mailto:${site.email}`} class="link-underline text-chalk">{site.email}</a></li>
          <li>
            <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="text-chalk-soft transition-colors hover:text-chalk">LinkedIn</a>
          </li>
        </ul>
        <address class="mt-5 text-[13.5px] not-italic leading-relaxed text-chalk-mute">
          <span class="mb-0.5 block text-[12px] uppercase tracking-wide">Office address</span>
          {site.address.street}, {site.address.city}, {site.address.region} {site.address.postal}, {site.address.country}
        </address>
      </div>

      <nav aria-label="Footer" class="grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-4">
        {
          groups.map((g) => (
            <div>
              <p class="text-[13px] font-medium text-chalk-mute">{g.title}</p>
              <ul class="mt-3 text-[15px]">
                {g.links.map((l) => (
                  <li>
                    <a href={l.href} class={link}>
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-chalk/12 pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-[13px] text-chalk-mute">&copy; {year} {site.name} All rights reserved.</p>

      <div class="flex flex-wrap items-center gap-x-6 text-[13px] text-chalk-mute">
        <div class="inline-flex items-center gap-2" role="group" aria-label="Choose how to read this page">
          <span class="label-mono">View as</span>
          <span class="inline-flex overflow-hidden rounded-full border border-chalk/20 text-[12px]">
            <span aria-current="true" class="bg-chalk/12 px-3 py-1.5 text-chalk">Human</span>
            <a id="agent-view" href="/index.md" rel="alternate" type="text/markdown" class="inline-flex min-h-[32px] items-center px-3 py-1.5 transition-colors hover:text-chalk">Agent</a>
          </span>
        </div>
        <a href="/for-agents/" class="inline-flex min-h-[44px] items-center transition-colors hover:text-chalk-soft">For AI agents</a>
        <a href="/privacy" class="inline-flex min-h-[44px] items-center transition-colors hover:text-chalk-soft">Privacy</a>
        <a href="/terms" class="inline-flex min-h-[44px] items-center transition-colors hover:text-chalk-soft">Terms</a>
        <button type="button" id="consent-open" class="min-h-[44px] transition-colors hover:text-chalk-soft">Analytics settings</button>
        <span>Toronto, Canada</span>
      </div>
    </div>
    <p class="mt-6 max-w-3xl text-[12px] leading-relaxed text-chalk-mute/80">
      Cloudflare, the Cloudflare logo, and Cloudflare Workers are trademarks and/or registered trademarks of
      Cloudflare, Inc. in the United States and other jurisdictions. {site.name} is an independent company.
    </p>
  </div>
</footer>

<script>
  const agent = document.getElementById("agent-view") as HTMLAnchorElement | null;
  if (agent) {
    const p = location.pathname;
    agent.href = p === "/" ? "/index.md" : p.replace(/\/$/, "") + ".md";
  }
  document.getElementById("consent-open")?.addEventListener("click", () => {
    window.dispatchEvent(new CustomEvent("kaba:consent-open"));
  });
</script>
