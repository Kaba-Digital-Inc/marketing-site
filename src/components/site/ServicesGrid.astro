---
import { services } from "@/lib/services";

interface Props {
  limit?: number;
  /** Heading level for service titles; use "h2" when the grid sits directly under the page h1. */
  heading?: "h2" | "h3";
}

const { limit, heading: Heading = "h3" } = Astro.props;
const list = typeof limit === "number" ? services.slice(0, limit) : services;
---

<ul class="divide-y divide-line border-t border-line">
  {
    list.map((service) => (
      <li class="grid gap-4 py-8 sm:grid-cols-[0.9fr_1.1fr] sm:gap-12 lg:py-9">
        <div>
          <Heading class="font-display text-[21px] font-semibold leading-snug text-ink">{service.title}</Heading>
          <p class="mt-2 text-[14px] text-ink-mute">{service.outcome}</p>
        </div>
        <div>
          <p class="measure text-[16px] leading-relaxed text-ink-soft text-pretty">{service.summary}</p>
          <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-2">
            {service.capabilities.map((c) => (
              <li class="text-[13.5px] text-ink-mute">{c}</li>
            ))}
          </ul>
          {service.links && (
            <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-1">
              {service.links.map((l) => (
                <li>
                  <a href={l.href} class="link-underline text-[14.5px]">
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      </li>
    ))
  }
</ul>
