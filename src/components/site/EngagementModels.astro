---
const models = [
  {
    name: "Advisory sprint",
    best: "You need a decision and a plan",
    cadence: "1–2 weeks",
    body: "A short, fixed engagement that finds the highest-value AI opportunity, tests it against real data, and hands you a costed roadmap.",
  },
  {
    name: "Build engagement",
    best: "You have a system to ship",
    cadence: "6–16 weeks",
    body: "Milestone-based delivery of a production agent or AI feature on Cloudflare, from architecture through launch.",
  },
  {
    name: "Managed partnership",
    best: "You want it run for you",
    cadence: "Monthly",
    body: "Ongoing operation of your AI systems and Cloudflare estate: monitoring, tuning, upgrades, and a named contact.",
  },
];
---

<section class="py-20 lg:py-28">
  <div class="shell">
    <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <div>
        <span class="kicker">Ways to engage</span>
        <h2 class="text-title mt-5 font-display font-semibold text-ink text-balance">
          Three shapes of engagement.
        </h2>
        <p class="measure mt-5 text-[17px] leading-relaxed text-ink-soft text-pretty">
          Scoped to the outcome. Every engagement opens with a call and a written proposal, so there is nothing to
          discover halfway through.
        </p>
        <a href="/contact" class="btn-solid mt-8">Talk through your options</a>
      </div>

      <ul class="border-t border-line">
        {
          models.map((m) => (
            <li class="grid gap-3 border-b border-line py-7 sm:grid-cols-[0.8fr_1.2fr] sm:gap-10">
              <div>
                <h3 class="font-display text-[20px] font-semibold text-ink">{m.name}</h3>
                <p class="mt-1.5 text-[13.5px] text-ink-mute">{m.best}</p>
              </div>
              <div>
                <p class="text-[15.5px] leading-relaxed text-ink-soft text-pretty">{m.body}</p>
                <p class="mt-3 text-[13.5px] text-ultra">{m.cadence}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
