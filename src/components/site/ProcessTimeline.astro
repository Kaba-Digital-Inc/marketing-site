---
const phases = [
  {
    name: "Scope",
    span: "1–2 weeks",
    body: "We map the workflow, the data, and the constraints, then say plainly whether AI is the right tool. You get a written read, not a pitch.",
  },
  {
    name: "Prove",
    span: "2–3 weeks",
    body: "Architecture and a working prototype against your real data on Cloudflare. We test the risky part first, before the build is committed.",
  },
  {
    name: "Build",
    span: "4–12 weeks",
    body: "Production delivery in tight increments: agent logic, interface, data plane, evaluation, security, and deploys.",
  },
  {
    name: "Operate",
    span: "Ongoing",
    body: "We watch quality and cost, tune models and prompts, then hand the whole thing to your team with runbooks and training.",
  },
];
---

<section class="border-y border-line bg-panel py-20 lg:py-28">
  <div class="shell">
    <div class="max-w-xl">
      <span class="kicker">How we work</span>
      <h2 class="text-title mt-5 font-display font-semibold text-ink text-balance">
        Built to survive contact with production.
      </h2>
    </div>

    <div class="mt-14 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      {
        phases.map((phase) => (
          <div class="border-t border-chalk/25 pt-5">
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="font-display text-[24px] font-semibold tracking-tight text-ink">{phase.name}</h3>
              <span class="text-[13px] text-ink-mute">{phase.span}</span>
            </div>
            <p class="mt-4 text-[15px] leading-relaxed text-ink-soft text-pretty">{phase.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
