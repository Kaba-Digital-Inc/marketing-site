---
import StoryScene from "@/components/StoryScene";
import EngagementJourney from "@/components/EngagementJourney";

const steps = [
  {
    title: "We scope it",
    body: "We map the workflow, the data, and the constraints, then say plainly whether AI is the right tool.",
    story: "scope",
    storyLabel: "A support workflow is mapped step by step, each step's data is traced, each step is tested on security, cost, and accuracy, and each is marked AI or plain rules.",
  },
  {
    title: "We prove it",
    body: "A working prototype on your real data, so the riskiest part is tested before the build is committed.",
    story: "prove",
    storyLabel: "The riskiest part is picked, a small prototype is built and run on twelve real samples, and the accuracy result decides whether to build.",
  },
  {
    title: "We build it",
    body: "Production delivery with evaluation, guardrails, and security, released in stages and measured at each one.",
    story: "build",
    storyLabel: "A pipeline of builds, tests, guardrails, and a security review, then a release in stages of five, twenty-five, and one hundred percent.",
  },
  {
    title: "We run it",
    body: "We watch quality and cost, tune what drifts, and hand over documentation your team can own.",
    story: "run",
    storyLabel: "Live quality and cost charts catch a drift, it is tuned and fixed, and the documentation is handed over to your team.",
  },
];
---

<section class="relative overflow-hidden">
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-[520px] opacity-[0.5]"
    style="background: radial-gradient(60% 60% at 50% 0%, rgba(53,214,245,0.12) 0%, transparent 70%);"
  >
  </div>

  <div class="shell relative pt-10 lg:pt-14">
    <!--md-skip-start-->
    <div class="flex items-center gap-3" role="group" aria-label="Choose how to read this page">
      <span class="label-mono">View as</span>
      <span class="inline-flex overflow-hidden rounded-full border border-line-2 bg-panel/60 text-[13px] backdrop-blur">
        <button type="button" id="view-human" aria-pressed="true" class="min-h-[36px] px-4 text-chalk transition-colors aria-pressed:bg-signal aria-pressed:text-[#04222a]">Human</button>
        <a id="view-agent" href="/index.md" aria-pressed="false" role="button" class="inline-flex min-h-[36px] items-center px-4 text-chalk-soft transition-colors hover:text-chalk aria-pressed:bg-signal aria-pressed:text-[#04222a]">Agent</a>
      </span>
    </div>

    <div id="agent-panel" hidden class="panel mt-8 overflow-hidden">
      <div class="flex flex-wrap items-center gap-2 border-b border-line px-5 py-3">
        <span class="h-2.5 w-2.5 rounded-full bg-line-2"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-line-2"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-line-2"></span>
        <span class="label-mono ml-3 normal-case tracking-normal">GET /index.md &middot; text/markdown</span>
        <span class="ml-auto flex gap-5 text-[13px]">
          <a href="/index.md" class="link-underline">Raw markdown</a>
          <a href="/llms.txt" class="link-underline">llms.txt</a>
        </span>
      </div>
      <pre id="agent-text" tabindex="0" class="max-h-[560px] overflow-auto whitespace-pre-wrap break-words px-5 py-6 font-mono text-[12.5px] leading-[1.8] text-chalk-soft sm:px-7">Loading the markdown version of this page&hellip;</pre>
      <p class="border-t border-line px-5 py-3 text-[13px] text-chalk-mute sm:px-7">
        This is what an AI agent reads: the same page without the layout. Every page has one, and the whole site is in llms-full.txt.
      </p>
    </div>

    <!--md-skip-end-->

    <div id="hero-human" class="mt-8 grid items-center gap-10 lg:grid-cols-[1fr_1fr] lg:gap-10">
      <div>
        <span class="kicker">AI agent development · Toronto</span>

        <h1 class="mt-6 max-w-[19ch] font-display text-[clamp(2.4rem,5.2vw,4.2rem)] font-semibold leading-[1.04] tracking-[-0.03em] text-chalk text-balance">
          AI agents and automation that work in production.
        </h1>

        <p class="measure mt-7 text-[17px] leading-relaxed text-chalk-soft text-pretty">
          For small businesses, startups, and enterprise teams. Start with a fixed-scope audit, get a working agent
          in weeks, and we run it after launch. Selected startups can partner with us for equity.
        </p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href="/contact/" class="btn-solid">Book a call</a>
          <a href="#how" class="btn-quiet">See how it works</a>
        </div>

        <p class="mt-5 text-[14.5px] text-chalk-mute">
          Building a startup?{" "}
          <a href="/startups/#apply" class="link-underline text-chalk">Apply for a partnership</a>
        </p>

        <p class="label-mono mt-7">Fixed scope · Enterprise-grade engineering · Toronto, working worldwide</p>
      </div>

      <div class="relative mx-auto w-full max-w-[480px] lg:max-w-none">
        <div class="aspect-[460/420] w-full">
          <StoryScene
            client:visible
            scene="hero"
            label="An AI support agent takes in customer requests, does the work, and sends the result. Anything it is unsure about passes a guardrail gate where a person approves it first."
          />
        </div>
      </div>
    </div>
  </div>

  <div id="how" class="shell relative scroll-mt-24 pb-20 pt-12 lg:pb-24">
    <div class="panel relative overflow-hidden">
      <EngagementJourney client:visible steps={steps} />
    </div>
  </div>
</section>

<script>
  const human = document.getElementById("view-human");
  const agent = document.getElementById("view-agent");
  const panel = document.getElementById("agent-panel");
  const heroHuman = document.getElementById("hero-human");
  const text = document.getElementById("agent-text");
  let loaded = false;

  function show(mode: "human" | "agent") {
    const isAgent = mode === "agent";
    human?.setAttribute("aria-pressed", String(!isAgent));
    agent?.setAttribute("aria-pressed", String(isAgent));
    if (panel) panel.hidden = !isAgent;
    if (heroHuman) heroHuman.hidden = isAgent;
    if (isAgent && !loaded && text) {
      loaded = true;
      fetch("/index.md")
        .then((r) => (r.ok ? r.text() : Promise.reject()))
        .then((t) => (text.textContent = t))
        .catch(() => {
          loaded = false;
          text.textContent = "Could not load the markdown version here. Open /index.md directly.";
        });
    }
  }

  human?.addEventListener("click", () => show("human"));
  agent?.addEventListener("click", (e) => {
    e.preventDefault();
    show("agent");
  });
</script>
