---
import Figure from "@/components/Figure";
import { audit } from "@/lib/site";

const steps = [
  {
    title: "Something arrives",
    body: "An email, a form, a call, a file. The trigger is whatever your team already handles by hand today.",
  },
  {
    title: "The agent does the work",
    body: "It reads, checks, decides, and acts across your tools, following rules you wrote and can read.",
  },
  {
    title: "A person approves what matters",
    body: "Routine cases run alone. Anything above a threshold you set waits for a human, with the reasoning attached.",
  },
  {
    title: "Everything is logged and measured",
    body: "Each step is recorded and replayable, so you can audit it, improve it, and show the result.",
  },
];

// Illustrative workflow, not a real client system.
const code = [
  { n: 1, t: [["k", "workflow"], ["p", ": "], ["s", "invoice-triage"]] },
  { n: 2, t: [["k", "trigger"], ["p", ": "], ["s", "email.received"]] },
  { n: 3, t: [["k", "steps"], ["p", ":"]] },
  { n: 4, t: [["p", "  - "], ["k", "read"], ["p", ": "], ["s", "attachments"], ["p", " → "], ["s", "extract(fields)"]] },
  { n: 5, t: [["p", "  - "], ["k", "check"], ["p", ": "], ["s", "total matches purchase order"]] },
  { n: 6, t: [["p", "  - "], ["k", "approve"], ["p", ": "], ["s", "human"], ["p", " if "], ["n", "amount > 5000"]] },
  { n: 7, t: [["p", "  - "], ["k", "write"], ["p", ": "], ["s", "accounting.create_bill"]] },
  { n: 8, t: [["k", "audit"], ["p", ": "], ["s", "every step logged, replayable"]] },
];

const log = [
  { time: "09:14:02", mark: "✓", color: "text-emerald-400", step: "read", msg: "6 fields extracted from invoice.pdf" },
  { time: "09:14:03", mark: "!", color: "text-[#f2b35e]", step: "check", msg: "total differs from PO by $42.10" },
  { time: "09:14:03", mark: "→", color: "text-signal", step: "approve", msg: "sent to Finance, reasoning attached" },
  { time: "09:21:40", mark: "✓", color: "text-emerald-400", step: "write", msg: "approved, bill created in accounting" },
];

const tone: Record<string, string> = {
  k: "text-signal",
  p: "text-chalk-mute",
  s: "text-chalk",
  n: "text-[#f2b35e]",
};
---

<section class="relative overflow-hidden">
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-[520px] opacity-[0.5]"
    style="background: radial-gradient(60% 60% at 50% 0%, rgba(53,214,245,0.12) 0%, transparent 70%);"
  >
  </div>

  <div class="shell relative pt-14 lg:pt-20">
    <div class="grid items-center gap-10 lg:grid-cols-[1.2fr_0.8fr] lg:gap-6">
      <div>
        <span class="kicker">AI engineering studio</span>

        <h1 class="text-display mt-6 max-w-[15ch] font-display font-semibold text-chalk text-balance">
          We help businesses become AI-native.
        </h1>

        <p class="measure mt-7 text-[17px] leading-relaxed text-chalk-soft text-pretty">
          Production AI agents, automation, and products, engineered to enterprise standards and delivered at
          small-team speed. From your first workflow to your whole operation.
        </p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href="/ai-native#audit" class="btn-solid">Book an {audit.name}</a>
          <a href="/ai-native" class="btn-quiet">See how it works</a>
        </div>

        <p class="label-mono mt-8">Built in regulated enterprise environments · Used by startups to large teams</p>
      </div>

      <div class="relative mx-auto w-full max-w-[460px] origin-center sm:scale-[1.15] lg:max-w-none lg:scale-[1.35]">
        <Figure
          client:visible
          name="exploded"
          label="An application shown in four separated layers, standing for the layers of an AI system"
          intensity={0.7}
          plate="#08090a"
        />
      </div>
    </div>
  </div>

  <div class="shell relative pb-20 pt-12 lg:pb-24">
    <div class="panel relative overflow-hidden">
      <div class="grid lg:grid-cols-[1.05fr_0.95fr]">
        <div class="border-b border-line lg:border-b-0 lg:border-r">
          <div class="flex items-center gap-2 border-b border-line px-5 py-3">
            <span class="h-2.5 w-2.5 rounded-full bg-line-2"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-line-2"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-line-2"></span>
            <span class="label-mono ml-3 normal-case tracking-normal">workflow.yaml</span>
            <span class="label-mono ml-auto">example</span>
          </div>
          <div
            class="overflow-x-auto px-5 py-6 font-mono text-[13px] leading-[1.9] sm:px-7 sm:text-[13.5px]"
            role="img"
            aria-label="Example AI workflow definition: an invoice triage workflow that reads attachments, checks totals against the purchase order, asks a human to approve large amounts, writes the bill, and logs every step."
          >
            {
              code.map((line) => (
                <div class="flex gap-4">
                  <span class="w-4 shrink-0 select-none text-right text-chalk-mute/60">{line.n}</span>
                  <span class="whitespace-pre">
                    {line.t.map(([c, s]) => (
                      <span class={tone[c]}>{s}</span>
                    ))}
                  </span>
                </div>
              ))
            }
          </div>

          <div class="border-t border-line px-5 py-5 font-mono text-[12.5px] leading-[1.9] sm:px-7">
            <p class="label-mono mb-3">Run log · example</p>
            <ul class="space-y-0.5 overflow-x-auto">
              {
                log.map((l) => (
                  <li class="flex gap-3 whitespace-nowrap">
                    <span class="text-chalk-mute/60">{l.time}</span>
                    <span class={l.color}>{l.mark}</span>
                    <span class="w-[4.5rem] text-chalk-mute">{l.step}</span>
                    <span class="text-chalk-soft">{l.msg}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <div class="px-7 py-10 sm:px-10 lg:py-12">
          <h2 class="font-display text-[28px] font-semibold leading-tight tracking-tight text-chalk sm:text-[32px]">
            <span class="text-signal">How</span> an AI-native workflow runs
          </h2>

          <ol class="mt-8 space-y-7">
            {
              steps.map((step, i) => (
                <li class="flex gap-5">
                  <span
                    class={`mt-0.5 grid h-8 w-8 shrink-0 place-items-center rounded-full border text-[13px] font-medium ${
                      i === 0
                        ? "border-signal bg-signal text-[#04222a]"
                        : "border-line-2 text-chalk-mute"
                    }`}
                  >
                    {i + 1}
                  </span>
                  <div>
                    <h3 class="font-display text-[17px] font-semibold leading-snug text-chalk">{step.title}</h3>
                    <p class="measure mt-1.5 text-[14.5px] leading-relaxed text-chalk-mute text-pretty">
                      {step.body}
                    </p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </div>
</section>
