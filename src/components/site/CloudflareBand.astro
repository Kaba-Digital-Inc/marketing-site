---
const program = [
  ["Accounts", "One managed account per customer, scoped access"],
  ["Billing", "Consolidated across every account"],
  ["Catalog", "The full self-serve product range"],
  ["Pricing", "Partner plan discounts passed through"],
  ["Commitment", "No upfront minimum to start"],
];

const capabilities = [
  {
    name: "Migration & setup",
    body: "DNS cutover, zones, bindings, and environments set up the way an engineer would want to work in them.",
  },
  {
    name: "Zero Trust & security",
    body: "Access, Gateway, WARP, tunnels, WAF and bot controls rolled out without breaking day-to-day work.",
  },
  {
    name: "Platform engineering",
    body: "Workers, Pages, R2, D1, Queues and Vectorize wired into a deploy pipeline your team can run.",
  },
  {
    name: "Ongoing operations",
    body: "Monitoring, incident response, cost review, and upgrades. We stay on the account with you.",
  },
];
---

<section class="night py-20 lg:py-28">
  <div class="shell">
    <div class="grid gap-12 lg:grid-cols-[1fr_1fr] lg:gap-20">
      <div>
        <span class="kicker">Managed Cloudflare</span>
        <h2 class="text-title mt-5 font-display font-semibold text-chalk text-balance">
          We can also run the platform for you.
        </h2>
        <p class="measure mt-5 text-[17px] leading-relaxed text-chalk-soft text-pretty">
          Building on Cloudflare is one offer. Operating it is another. As a Cloudflare self-serve partner we manage
          customer accounts, consolidate billing, and apply partner plan pricing, so a growing team gets the whole
          platform without building a platform team first.
        </p>

        <dl class="mt-9 border-t border-chalk/12">
          {
            program.map(([k, v]) => (
              <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b border-chalk/12 py-3.5">
                <dt class="text-[15px] font-medium text-chalk">{k}</dt>
                <dd class="text-[15px] text-chalk-mute">{v}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="grid gap-x-12 gap-y-9 sm:grid-cols-2 lg:content-start">
        {
          capabilities.map((c) => (
            <div class="border-t border-chalk/12 pt-6">
              <h3 class="font-display text-[18px] font-semibold text-chalk">{c.name}</h3>
              <p class="mt-2.5 text-[15px] leading-relaxed text-chalk-mute text-pretty">{c.body}</p>
            </div>
          ))
        }
        <div class="sm:col-span-2">
          <a href="/cloudflare" class="link-underline text-[15px]">
            Cloudflare engineering &amp; managed services
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
