---
import Figure, { type FigureName } from "@/components/Figure";

interface Props {
  kicker: string;
  title: string;
  lede?: string;
  figure?: FigureName;
  figureLabel?: string;
}

const { kicker, title, lede, figure, figureLabel = "Decorative isometric illustration" } = Astro.props;
---

<section class="relative overflow-hidden border-b border-line">
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-[360px] opacity-[0.45]"
    style="background: radial-gradient(55% 70% at 50% 0%, rgba(53,214,245,0.10) 0%, transparent 70%);"
  >
  </div>
  <div class="shell relative py-16 lg:py-24">
    <div class={figure ? "grid items-center gap-10 lg:grid-cols-[1.15fr_0.85fr]" : ""}>
      <div>
        <span class="kicker">{kicker}</span>
        <h1 class="text-title mt-6 max-w-[20ch] font-display font-semibold text-ink text-balance">{title}</h1>
        {lede && <p class="measure mt-7 text-lg leading-relaxed text-ink-soft text-pretty">{lede}</p>}
      </div>
      {
        figure && (
          <div class="hidden lg:block">
            <Figure client:visible name={figure} label={figureLabel} intensity={0.6} plate="#08090a" />
          </div>
        )
      }
    </div>
  </div>
</section>
