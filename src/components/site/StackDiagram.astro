---
// An isometric slice of the stack: a dashed perspective plane with stacked
// cards and one signal pulse travelling through it. Built with CSS 3D
// transforms and a single keyframe set, so there is no runtime cost and the
// whole thing stops under prefers-reduced-motion.

const cards = [
  { label: "Client SDKs", note: "browser, mobile, HTTP", z: 0, accent: false },
  { label: "Agent runtime", note: "Durable Object, state", z: 46, accent: true },
  { label: "Platform services", note: "AI Gateway, Vectorize", z: 92, accent: false },
];

const icons = ["globe", "cube", "layers"];
---

<div class="iso-stage relative" aria-hidden="true">
  <div class="iso-plane">
    <!-- Dashed perspective plane -->
    <div class="iso-grid"></div>

    {
      cards.map((card, i) => (
        <div class="iso-card node-in" style={`--i:${i}; --z:${card.z}px`}>
          <div class={`iso-face ${card.accent ? "iso-face-accent" : ""}`}>
            <div class="flex items-center justify-between">
              <span class="iso-icon">
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3">
                  {icons[i] === "globe" && (
                    <>
                      <circle cx="10" cy="10" r="7" />
                      <path d="M3 10h14M10 3c2.2 2 2.2 12 0 14M10 3c-2.2 2-2.2 12 0 14" />
                    </>
                  )}
                  {icons[i] === "cube" && (
                    <>
                      <path d="M10 2.5 17 6.5v7L10 17.5 3 13.5v-7z" />
                      <path d="M3 6.5 10 10.5l7-4M10 10.5v7" />
                    </>
                  )}
                  {icons[i] === "layers" && (
                    <>
                      <path d="M10 3 17 7l-7 4-7-4z" />
                      <path d="M3 11l7 4 7-4" />
                    </>
                  )}
                </svg>
              </span>
              <span class="iso-dots">•••</span>
            </div>
            <p class="iso-label">{card.label}</p>
            <p class="iso-note">{card.note}</p>
            <div class="iso-rows">
              <span></span>
              <span></span>
              <span class="iso-rows-accent"></span>
            </div>
          </div>
        </div>
      ))
    }

    <!-- The pulse: one travelling highlight across the plane -->
    <div class="iso-pulse pulse-out" style="--i:2"></div>

    <span class="iso-tag iso-tag-a">CLIENT SDKS</span>
    <span class="iso-tag iso-tag-b">USER</span>
  </div>
</div>

<style>
  .iso-stage {
    width: 100%;
    height: 100%;
    min-height: 420px;
    perspective: 1400px;
    overflow: hidden;
  }

  .iso-plane {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: rotateX(58deg) rotateZ(-42deg) translateX(6%) translateY(-4%);
    transform-origin: 50% 60%;
  }

  /* Dashed perspective grid on the ground plane */
  .iso-grid {
    position: absolute;
    inset: -20% -10%;
    background-image: linear-gradient(to right, rgba(53, 214, 245, 0.16) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(53, 214, 245, 0.16) 1px, transparent 1px);
    background-size: 46px 46px;
    border: 1px solid rgba(53, 214, 245, 0.14);
    mask-image: radial-gradient(115% 95% at 50% 45%, #000 30%, transparent 78%);
  }

  .iso-card {
    position: absolute;
    left: 50%;
    top: 42%;
    width: 232px;
    margin-left: -116px;
    margin-top: -70px;
    transform: translateZ(var(--z, 0px));
    transform-style: preserve-3d;
  }

  .iso-face {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    background: linear-gradient(160deg, rgba(23, 27, 31, 0.96), rgba(10, 12, 14, 0.92));
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.95);
    padding: 14px 15px 15px;
    color: #6d747e;
  }

  .iso-face-accent {
    border-color: rgba(53, 214, 245, 0.42);
    box-shadow: 0 0 0 1px rgba(53, 214, 245, 0.12), 0 30px 60px -28px rgba(53, 214, 245, 0.3);
    color: #35d6f5;
  }

  .iso-icon {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.09);
    background: rgba(255, 255, 255, 0.03);
  }

  .iso-icon svg {
    width: 18px;
    height: 18px;
  }

  .iso-dots {
    letter-spacing: 2px;
    font-size: 11px;
    color: #4b525b;
  }

  .iso-label {
    margin-top: 12px;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 600;
    color: #f2f4f6;
    letter-spacing: -0.01em;
  }

  .iso-note {
    margin-top: 2px;
    font-size: 11.5px;
    color: #6d747e;
  }

  .iso-rows {
    margin-top: 12px;
    display: grid;
    gap: 6px;
  }

  .iso-rows span {
    height: 5px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.07);
  }

  .iso-rows span:nth-child(1) {
    width: 72%;
  }

  .iso-rows span:nth-child(2) {
    width: 48%;
  }

  .iso-rows-accent {
    width: 30%;
    background: rgba(53, 214, 245, 0.55) !important;
  }

  .iso-pulse {
    position: absolute;
    left: 50%;
    top: 42%;
    width: 120px;
    height: 120px;
    margin: -60px 0 0 -60px;
    border-radius: 999px;
    background: radial-gradient(circle at center, rgba(53, 214, 245, 0.55), transparent 68%);
    filter: blur(6px);
  }

  .iso-tag {
    position: absolute;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.2em;
    color: #566069;
    transform: rotateZ(42deg) rotateX(-58deg);
  }

  .iso-tag-a {
    right: 16%;
    bottom: 26%;
  }

  .iso-tag-b {
    left: 44%;
    bottom: 12%;
  }

  @media (max-width: 640px) {
    .iso-stage {
      min-height: 320px;
    }

    .iso-card {
      width: 190px;
      margin-left: -95px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .iso-plane {
      transform: rotateX(52deg) rotateZ(-38deg);
    }
  }
</style>