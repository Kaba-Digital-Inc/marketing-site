---
import Layout from "@/layouts/Layout.astro";
import CTA from "@/components/site/CTA.astro";
import { render } from "astro:content";
import { getVisibleProjects, relationshipNote } from "@/lib/projects";
import { getPartnersBySlugs } from "@/lib/partners";
import PartnerLogos from "@/components/site/PartnerLogos.astro";
import { site } from "@/lib/site";

export async function getStaticPaths() {
  const projects = await getVisibleProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const sponsors = await getPartnersBySlugs(data.partners);
const url = new URL(`/work/${project.id}/`, site.url).href;

const schema = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: data.title,
  headline: data.tagline,
  description: data.description,
  url,
  ...(data.url ? { sameAs: data.url } : {}),
  ...(data.image ? { image: new URL(data.image, site.url).href } : {}),
  creator: { "@id": site.url + "/#organization" },
};
---

<Layout title={data.seoTitle ?? `${data.title}: ${data.tagline}`} description={data.description} schema={[schema]} crumbLabel={data.title}>
  <article class="border-b border-line">
    <header class="shell pt-14 lg:pt-20">
      <a href="/work/" class="link-underline text-[14px] text-ink-mute">← All work</a>
      <div class="mt-8 flex items-center gap-3">
        <span class={`inline-block h-2 w-2 rounded-full ${data.status === "live" ? "bg-emerald-500" : "bg-signal"}`} />
        <span class="text-[13px] font-medium text-ink-mute">
          {data.status === "live" ? "Live" : "In development"} · {relationshipNote[data.relationship]}
        </span>
      </div>
      <h1 class="text-display mt-5 max-w-[16ch] font-display font-semibold text-ink text-balance">{data.title}</h1>
      <p class="measure mt-6 text-[20px] leading-snug text-ink-soft text-pretty">{data.tagline}</p>
      {
        data.url && (
          <a href={data.url} target="_blank" rel="noopener noreferrer" class="btn-solid mt-8 inline-flex">
            Visit {new URL(data.url).host}
          </a>
        )
      }
    </header>

    {
      data.image && (
        <div class="shell mt-12">
          <div class="panel overflow-hidden">
            <div class="flex items-center gap-1.5 border-b border-line px-4 py-3">
              <span class="h-2.5 w-2.5 rounded-full bg-line-2" />
              <span class="h-2.5 w-2.5 rounded-full bg-line-2" />
              <span class="h-2.5 w-2.5 rounded-full bg-line-2" />
              <span class="label-mono ml-3 truncate normal-case tracking-normal">
                {data.url ? new URL(data.url).host : data.title}
              </span>
            </div>
            <img src={data.image} alt={data.imageAlt ?? data.title} width="1280" height="800" class="block h-auto w-full" />
          </div>
        </div>
      )
    }

    <div class="shell pb-16 pt-12 lg:pb-24">
      <div class="grid gap-12 lg:grid-cols-[1fr_0.42fr] lg:gap-16">
        <div class="prose-kaba max-w-[68ch]">
          <Content />
        </div>
        <aside class="lg:pt-2">
          <dl class="border-t border-line">
            <div class="border-b border-line py-5">
              <dt class="label-mono">Our role</dt>
              <dd class="mt-2 text-[15px] text-ink-soft">{relationshipNote[data.relationship]}</dd>
            </div>
            {
              data.stack.length > 0 && (
                <div class="border-b border-line py-5">
                  <dt class="label-mono">Built with</dt>
                  <dd class="mt-3 flex flex-wrap gap-2">
                    {data.stack.map((s) => (
                      <span class="rounded-full border border-line px-3 py-1 text-[12.5px] text-ink-mute">{s}</span>
                    ))}
                  </dd>
                </div>
              )
            }
            {
              sponsors.length > 0 && (
                <div class="border-b border-line py-5">
                  <PartnerLogos partners={sponsors} label="Supported by" size="sm" />
                  <a href="/partners/" class="link-underline mt-3 inline-block text-[13.5px]">
                    About our partners
                  </a>
                </div>
              )
            }
            {
              data.tags.length > 0 && (
                <div class="border-b border-line py-5">
                  <dt class="label-mono">Focus</dt>
                  <dd class="mt-2 text-[15px] text-ink-soft">{data.tags.join(", ")}</dd>
                </div>
              )
            }
          </dl>
        </aside>
      </div>
    </div>
  </article>
  <CTA />
</Layout>
