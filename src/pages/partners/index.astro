---
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/site/PageHero.astro";
import CTA from "@/components/site/CTA.astro";
import { getPartners, partnerHref } from "@/lib/partners";

const partners = await getPartners();
const platform = partners.filter((p) => p.data.kind === "Platform");
const sponsors = partners.filter((p) => p.data.kind === "Sponsor");
// Cloudflare is also a ClawBuilders sponsor, so it leads that list too.
const supporters = [...platform, ...sponsors];
---

<Layout
  title="Partners and sponsors"
  description="The platforms we build on and the sponsors who back ClawBuilders, the agent builder community Kaba Digital runs. Plain statements of where each relationship stands."
>
  <PageHero
    kicker="Partners"
    title="Who we build with, and who backs what we run."
    lede="The platforms we build on and the companies that sponsor ClawBuilders, with a plain statement of where each relationship stands."
    figure="patch"
    figureLabel="A patch panel of ports and cables, standing for connected partners"
  />

  <section class="py-20 lg:py-28">
    <div class="shell">
      <div class="max-w-2xl">
        <span class="kicker">Platform</span>
        <h2 class="text-title mt-5 font-display font-semibold text-ink text-balance">The platform we build on.</h2>
      </div>

      <ul class="mt-10 grid gap-5">
        {
          platform.map((p) => {
            const link = partnerHref(p);
            return (
              <li>
                <a
                  href={link.href}
                  class="group panel grid items-center gap-6 p-7 transition-colors hover:border-line-2 sm:grid-cols-[auto_1fr_auto] sm:gap-8"
                >
                  <img src={p.data.logo} alt="" class="h-12 w-12" loading="lazy" />
                  <div>
                    <h3 class="font-display text-[24px] font-semibold text-ink">{p.data.name}</h3>
                    <p class="mt-1.5 text-[15px] leading-relaxed text-ink-soft">{p.data.tagline}</p>
                    {p.data.status && <p class="mt-3 text-[13px] text-signal">{p.data.status}</p>}
                  </div>
                  <span class="text-[15px] font-medium text-signal">
                    {p.data.page ? "How we work together" : "Visit"}
                    <span class="ml-1 inline-block transition-transform group-hover:translate-x-1">→</span>
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <section class="border-y border-line bg-paper-2 py-20 lg:py-28">
    <div class="shell">
      <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
        <div>
          <span class="kicker">ClawBuilders sponsors</span>
          <h2 class="text-title mt-5 font-display font-semibold text-ink text-balance">
            Companies that back the builders.
          </h2>
          <p class="measure mt-5 text-[17px] leading-relaxed text-ink-soft text-pretty">
            <a href="/work/clawbuilders/" class="link-underline">ClawBuilders</a> is the agent builder community we
            run. These companies sponsor its chapter nights, workshops, and prize pools. Where a sponsor has worked with
            us on something specific, it has its own page.
          </p>
          <a
            href="https://clawbuilders.club/sponsors"
            target="_blank"
            rel="noopener noreferrer"
            class="link-underline mt-7 inline-block text-[15px]"
          >
            Sponsor ClawBuilders
          </a>
        </div>

        <ul class="grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2">
          {
            supporters.map((p) => {
              const link = partnerHref(p);
              return (
                <li class="bg-panel">
                  <a
                    href={link.href}
                    {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                    class="group flex h-full flex-col justify-between gap-5 p-6 transition-colors hover:bg-panel-2"
                  >
                    <div class="flex h-9 items-center gap-2.5">
                      {p.data.logoIsIcon ? (
                        <>
                          <img src={p.data.logo} alt="" class="h-8 w-8" loading="lazy" />
                          <span class="font-display text-[18px] font-semibold text-chalk">{p.data.name}</span>
                        </>
                      ) : (
                        <img src={p.data.logo} alt={p.data.name} style={`height:${Math.round(24 * p.data.logoScale)}px`} class="w-auto max-w-[170px]" loading="lazy" />
                      )}
                    </div>
                    <div>
                      <p class="text-[14.5px] leading-relaxed text-ink-soft">{p.data.tagline}</p>
                      <p class="mt-3 text-[13px] font-medium text-signal">
                        {p.data.page ? "Read more" : "Visit site"} <span aria-hidden="true">→</span>
                      </p>
                    </div>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20">
    <div class="shell">
      <p class="max-w-3xl text-[14.5px] leading-relaxed text-ink-mute">
        Logos and names belong to their respective owners and are shown to credit sponsors and platforms. Listing a
        company here does not imply certification or endorsement by that company unless a page says so explicitly.
      </p>
    </div>
  </section>

  <CTA />
</Layout>
