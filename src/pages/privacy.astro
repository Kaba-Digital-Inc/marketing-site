---
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/site/PageHero.astro";
import { site } from "@/lib/site";

const sections = [
  [
    "Information we collect",
    "When you contact us or book a call, we collect the details you provide, typically your name, email address, company, and the context of your enquiry. If you apply for a startup partnership, we also collect what you submit in the application, such as your startup, stage, traction, and expectations. If you contact us as an investor, we collect the details you provide about your fund and enquiry. We introduce a company to an investor only with the founders' consent, and we do not share one party's confidential information with another. If you choose to allow analytics, we also collect usage data as described below.",
  ],
  [
    "Analytics and cookies",
    "Analytics are off until you choose. If you select \"Allow analytics\", we load Google Analytics, which counts visits and page views, and LogRocket, which records anonymised sessions so we can find and fix confusing parts of the site. Form fields are masked and are not recorded. If you keep them off, neither service loads. You can change your choice at any time using \"Analytics settings\" in the footer.",
  ],
  [
    "How we use it",
    "We use your information to respond to enquiries, prepare proposals, deliver services, and improve this site. We do not sell personal information, and we share it only with service providers that help us operate, such as Web3Forms (which delivers our contact and application forms), Cal.com (scheduling), and email tools, under appropriate confidentiality terms.",
  ],
  [
    "Retention and security",
    "We keep enquiry and engagement records only as long as needed for the purpose they were collected, and we apply reasonable technical and organisational measures to protect them.",
  ],
  [
    "Your choices",
    "You can request access to, correction of, or deletion of the personal information we hold about you by emailing us. We will respond within a reasonable timeframe.",
  ],
];
---

<Layout title="Privacy policy" description="How Kaba Digital Inc. collects, uses, and protects personal information.">
  <PageHero kicker="Legal" title="Privacy policy" lede="How we handle the information you share with us." />

  <section class="py-20 lg:py-24">
    <div class="shell">
      <div class="max-w-2xl">
        {
          sections.map(([title, body]) => (
            <div class="border-t border-line py-8">
              <h2 class="font-display text-[21px] font-semibold text-ink">{title}</h2>
              <p class="mt-4 text-[16px] leading-relaxed text-ink-soft text-pretty">{body}</p>
            </div>
          ))
        }
        <div class="border-t border-line py-8">
          <h2 class="font-display text-[21px] font-semibold text-ink">Contact</h2>
          <p class="mt-4 text-[16px] leading-relaxed text-ink-soft">
            Questions about this policy? Email{" "}
            <a href={`mailto:${site.email}`} class="link-underline">{site.email}</a>.
          </p>
        </div>
        <p class="border-t border-line pt-6 text-[13px] text-ink-mute">
          Last updated {new Date().toLocaleDateString("en-CA", { year: "numeric", month: "long" })}
        </p>
      </div>
    </div>
  </section>
</Layout>
