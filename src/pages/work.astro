---
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/site/PageHero.astro";
import CTA from "@/components/site/CTA.astro";
import { products } from "@/lib/site";

const detail: Record<string, { problem: string; approach: string; stack: string[] }> = {
  "ClawBuilders.club": {
    problem:
      "Agent builders had no neutral, public way to compare harnesses and models. Benchmark claims were unverifiable and the results lived in private spreadsheets.",
    approach:
      "A public arena: connect a harness, run a fixed 20-task evaluation, and climb a live ELO ladder against real rivals. Spectator access means anyone can watch a run without signing up.",
    stack: ["Web frontend", "Evaluation runner", "Rating service", "Multi-tenant accounts", "Live leaderboard"],
  },
  OffloadVault: {
    problem:
      "Photo libraries lock people into one provider's storage. Anyone keeping their own buckets had no gallery experience close to the big clouds.",
    approach:
      "A gallery built on your own object storage. Bring your own bucket across 15 providers, with search, sharing, and organisation, and no lock-in to a single host.",
    stack: ["Bring-your-own-bucket", "15 storage providers", "Media pipeline", "Zero lock-in", "Fast delivery"],
  },
};

const patterns = [
  ["Document and knowledge agents", "Retrieval over contracts, tickets, and internal wikis with citations and access controls."],
  ["Operational workflow automation", "Agents that triage, route, draft, and act inside the tools a team already uses."],
  ["AI features in live products", "Search, summarisation, and assistants added to a shipping product without a rewrite."],
  ["Platform migration and modernisation", "Moving workloads onto modern edge and serverless platforms for cost, latency, and fewer moving parts."],
];
---

<Layout
  title="Work: products we build and systems we ship"
  description="ClawBuilders.club and OffloadVault, plus the AI agent, automation, and product engineering engagements Kaba Digital Inc. delivers for clients."
>
  <PageHero
    kicker="Work"
    figure="laptop"
    figureLabel="A laptop with its lid open"
    title="Products we build, and systems we ship."
    lede="We build our own products on the stack we recommend. It keeps the advice honest and the architecture tested against real users."
  />

  <section class="py-20 lg:py-24">
    <div class="shell space-y-20">
      {
        products.map((p) => {
          const d = detail[p.name];
          return (
            <article class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
              <div>
                <div class="flex items-center gap-3">
                  <span class={`inline-block h-2 w-2 rounded-full ${p.status === "In production" ? "bg-emerald-500" : "bg-ultra"}`} />
                  <span class="text-[13px] font-medium text-ink-mute">{p.status}</span>
                </div>
                <h2 class="mt-4 font-display text-[36px] font-semibold leading-none tracking-tight text-ink sm:text-[46px]">
                  {p.name}
                </h2>
                <a href={p.href} target="_blank" rel="noopener noreferrer" class="link-underline mt-5 inline-block text-[15px]">
                  Visit {p.name}
                </a>
                <ul class="mt-7 flex flex-wrap gap-2">
                  {d.stack.map((s) => (
                    <li class="rounded-full border border-line px-3.5 py-1.5 text-[13px] text-ink-mute">{s}</li>
                  ))}
                </ul>
                <a
                  href={p.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  tabindex="-1"
                  aria-hidden="true"
                  class="panel mt-8 block overflow-hidden transition-colors hover:border-line-2"
                >
                  <img src={p.image} alt={p.imageAlt} width="1280" height="800" loading="lazy" decoding="async" class="block h-auto w-full" />
                </a>
              </div>

              <div class="space-y-8">
                <div class="border-t border-chalk/25 pt-6">
                  <p class="text-[13px] font-medium text-ultra">The problem</p>
                  <p class="measure mt-3 text-[17px] leading-relaxed text-ink-soft text-pretty">{d.problem}</p>
                </div>
                <div class="border-t border-line pt-6">
                  <p class="text-[13px] font-medium text-ink-mute">Our approach</p>
                  <p class="measure mt-3 text-[17px] leading-relaxed text-ink-soft text-pretty">{d.approach}</p>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>

  <section class="border-y border-line bg-paper-2 py-20 lg:py-28">
    <div class="shell">
      <div class="max-w-xl">
        <span class="kicker">Client work</span>
        <h2 class="text-title mt-5 font-display font-semibold text-ink text-balance">
          The work we do behind NDAs.
        </h2>
        <p class="measure mt-5 text-[17px] leading-relaxed text-ink-soft text-pretty">
          Most client engagements stay private. These are the shapes we take on most often, and references are
          available on request.
        </p>
      </div>

      <ul class="mt-12 grid gap-x-12 gap-y-10 sm:grid-cols-2">
        {
          patterns.map(([name, body]) => (
            <li class="border-t border-line pt-6">
              <h3 class="font-display text-[20px] font-semibold text-ink">{name}</h3>
              <p class="mt-3 text-[16px] leading-relaxed text-ink-soft text-pretty">{body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CTA />
</Layout>
