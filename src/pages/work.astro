---
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/site/PageHero.astro";
import CTA from "@/components/site/CTA.astro";
import { getVisibleProjects, relationshipNote } from "@/lib/projects";

const projects = await getVisibleProjects();
// One project reads best as a wide side-by-side card; two or more become a grid of vertical cards.
const single = projects.length === 1;

const patterns = [
  ["Document and knowledge agents", "Retrieval over contracts, tickets, and internal wikis with citations and access controls."],
  ["Operational workflow automation", "Agents that triage, route, draft, and act inside the tools a team already uses."],
  ["AI features in live products", "Search, summarisation, and assistants added to a shipping product without a rewrite."],
  ["Platform migration and modernisation", "Moving workloads onto modern edge and serverless platforms for cost, latency, and fewer moving parts."],
];
---

<Layout
  title="Work: projects we build and systems we ship"
  description="The products and startup partnerships Kaba Digital Inc. builds and runs, plus the AI agent, automation, and product engineering engagements we deliver for clients."
>
  <PageHero
    kicker="Work"
    title="Projects we build, back, and ship."
    lede="Our own products, startups we partner with, and client work. Each one is built to production standards and run for real users."
    figure="laptop"
    figureLabel="A laptop with its lid open"
  />

  <section class="py-20 lg:py-24">
    <div class="shell">
      <ul class={`grid gap-6 ${single ? "" : "md:grid-cols-2"}`}>
        {
          projects.map((p) => (
            <li>
              <a
                href={`/work/${p.id}/`}
                class={`group panel overflow-hidden transition-colors hover:border-line-2 ${single ? "grid lg:grid-cols-[1.05fr_1fr]" : "flex h-full flex-col"}`}
              >
                {p.data.image && (
                  <div class={`border-b border-line bg-void ${single ? "lg:order-2 lg:border-b-0 lg:border-l" : ""}`}>
                    <img
                      src={p.data.image}
                      alt={p.data.imageAlt ?? p.data.title}
                      width="1280"
                      height="800"
                      loading="lazy"
                      decoding="async"
                      class={`block w-full transition-transform duration-500 group-hover:scale-[1.02] ${single ? "h-auto lg:h-full lg:object-cover lg:object-left-top" : "h-auto"}`}
                    />
                  </div>
                )}
                <div class={`flex flex-1 flex-col p-7 ${single ? "lg:justify-center lg:p-10" : ""}`}>
                  <div class="flex items-center gap-3">
                    <span class={`inline-block h-2 w-2 rounded-full ${p.data.status === "live" ? "bg-emerald-500" : "bg-signal"}`} />
                    <span class="text-[13px] font-medium text-ink-mute">
                      {p.data.status === "live" ? "Live" : "In development"} · {p.data.relationship}
                    </span>
                  </div>
                  <h2 class="mt-4 font-display text-[30px] font-semibold leading-tight text-ink">{p.data.title}</h2>
                  <p class="mt-2 text-[17px] text-ink">{p.data.tagline}</p>
                  <p class="measure mt-4 flex-1 text-[15.5px] leading-relaxed text-ink-soft text-pretty">{p.data.description}</p>
                  <ul class="mt-5 flex flex-wrap gap-2">
                    {p.data.tags.map((t) => (
                      <li class="rounded-full border border-line px-3 py-1 text-[12.5px] text-ink-mute">{t}</li>
                    ))}
                  </ul>
                  <span class="mt-6 inline-flex items-center gap-2 text-[15px] font-medium text-signal">
                    Read the case study <span class="transition-transform group-hover:translate-x-1">→</span>
                  </span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-8 text-[14px] text-ink-mute">
        {relationshipNote.Founded}. Startup partnerships and client projects are added here as they go public.
      </p>
    </div>
  </section>

  <section class="border-y border-line bg-paper-2 py-20 lg:py-28">
    <div class="shell">
      <div class="max-w-xl">
        <span class="kicker">Client work</span>
        <h2 class="text-title mt-5 font-display font-semibold text-ink text-balance">
          The work we do behind NDAs.
        </h2>
        <p class="measure mt-5 text-[17px] leading-relaxed text-ink-soft text-pretty">
          Most client engagements stay private. These are the shapes we take on most often, and references are
          available on request.
        </p>
      </div>

      <ul class="mt-12 grid gap-x-12 gap-y-10 sm:grid-cols-2">
        {
          patterns.map(([name, body]) => (
            <li class="border-t border-line pt-6">
              <h3 class="font-display text-[20px] font-semibold text-ink">{name}</h3>
              <p class="mt-3 text-[16px] leading-relaxed text-ink-soft text-pretty">{body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CTA variant="startup" />
</Layout>
