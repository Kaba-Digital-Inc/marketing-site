---
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/site/PageHero.astro";
import ContactChooser from "@/components/ContactChooser";
import { site } from "@/lib/site";

const next = [
  "A short message, or a 30-minute call, to understand the problem and the constraints.",
  "A short written read: whether it is worth building, and what it takes.",
  "A scoped proposal if there is a fit, with no obligation.",
];
---

<Layout
  title="Contact: book a call or send a message"
  description="Book a paid 30-minute enquiry call or send a free message to Kaba Digital Inc. about AI agents, automation, an AI-Native Audit, team AI labs, or a startup partnership."
>
  <PageHero
    kicker="Contact"
    title="Two ways to start."
    lede="Book a paid enquiry call, or send a free message and we will reply within one business day."
  />

  <section class="py-14 lg:py-20">
    <div class="shell">
      <ContactChooser client:load />
    </div>
  </section>

  <section class="border-t border-line bg-paper-2 py-16 lg:py-20">
    <div class="shell">
      <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
        <div>
          <h2 class="font-display text-[22px] font-semibold text-ink">What happens next</h2>
          <ol class="mt-5 space-y-3">
            {next.map((step, i) => (
              <li class="flex gap-4 text-[16px] leading-relaxed text-ink-soft">
                <span class="mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-full border border-line-2 text-[12px] text-ink-mute">{i + 1}</span>
                {step}
              </li>
            ))}
          </ol>
        </div>
        <dl class="grid gap-x-10 gap-y-6 sm:grid-cols-2">
          <div class="border-t border-line pt-4">
            <dt class="text-[13px] text-ink-mute">Email</dt>
            <dd class="mt-1.5"><a href={`mailto:${site.email}`} class="link-underline text-[16px]">{site.email}</a></dd>
          </div>
          <div class="border-t border-line pt-4">
            <dt class="text-[13px] text-ink-mute">Response time</dt>
            <dd class="mt-1.5 text-[16px] text-ink-soft">Within one business day</dd>
          </div>
          <div class="border-t border-line pt-4">
            <dt class="text-[13px] text-ink-mute">LinkedIn</dt>
            <dd class="mt-1.5"><a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="link-underline text-[16px]">Kaba Digital Inc.</a></dd>
          </div>
          <div class="border-t border-line pt-4">
            <dt class="text-[13px] text-ink-mute">Office address</dt>
            <dd class="mt-1.5 text-[15px] leading-relaxed text-ink-soft">
              {site.address.street}, {site.address.city}, {site.address.region} {site.address.postal}, {site.address.country}
            </dd>
            <dd class="mt-1 text-[13px] text-ink-mute">For mail and legal notices. We work remotely and meet by appointment.</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>
</Layout>
