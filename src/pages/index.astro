---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/site/Hero.astro";
import Doors from "@/components/site/Doors.astro";
import Partnership from "@/components/site/Partnership.astro";
import ServicesGrid from "@/components/site/ServicesGrid.astro";
import ProductsSection from "@/components/site/ProductsSection.astro";
import OfferLadder from "@/components/site/OfferLadder.astro";
import ProcessTimeline from "@/components/site/ProcessTimeline.astro";
import FAQ from "@/components/site/FAQ.astro";
import CTA from "@/components/site/CTA.astro";

const faqs = [
  {
    q: "What is AI agent development?",
    a: "AI agent development is building software agents that take on real work: reading requests, using your tools and data, making decisions within rules you set, and asking a person when it matters. We design them with evaluation, guardrails, and monitoring so they keep working after launch.",
  },
  {
    q: "What does an AI engineering studio do?",
    a: "We design, build, and run production AI systems: agents that do real work, voice and retrieval systems, and AI features in products. We also help decide where AI is worth using, and where it is not.",
  },
  {
    q: "How do your startup partnerships work?",
    a: "We work with a few startups at a time on a paid engagement plus a small equity stake, agreed in writing. We choose carefully, because we are investing our time and judgment. You can see the criteria and apply on our startups page.",
  },
  {
    q: "How is this different from a typical AI consultancy or agency?",
    a: "We build the systems, not only the plan, and we share in the outcome with the startups we back. Our work ships with evaluation, guardrails, and monitoring, and the engineers who scope the work are the ones who build it.",
  },
  {
    q: "Do you work with small businesses and enterprises too?",
    a: "Yes. Small and mid-sized businesses usually begin with a fixed-scope AI-Native Audit. Larger organisations typically need help taking pilots into production, with governance and security review.",
  },
  {
    q: "Do you work with investors?",
    a: "Yes. We run hands-on AI labs for portfolio teams, for a fee, and offer engineering support for portfolio companies, lightweight AI snapshots of companies, and, only with a founder's consent and never for a fee, introductions to companies that may fit an investor's focus. We do not give investment advice. See our investors page for how we work.",
  },
  {
    q: "Where are you based?",
    a: "Toronto, Canada. We work with teams worldwide, remotely and by video.",
  },
];
---

<Layout title="AI agent development and automation">
  <Hero />

  <Doors />

  <section class="border-t border-line py-20 lg:py-28">
    <div class="shell">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-xl">
          <span class="kicker">What we do</span>
          <h2 class="text-title mt-5 font-display font-semibold text-ink text-balance">
            Consulting that ends in working software.
          </h2>
        </div>
        <a href="/services/" class="link-underline shrink-0 text-[15px]">All services</a>
      </div>

      <div class="mt-12">
        <ServicesGrid limit={6} />
      </div>
    </div>
  </section>

  <OfferLadder
    kicker="Start here"
    heading="A fixed-scope audit is the easiest first step."
    intro="Whatever your size, you can start small, prove the value, then decide how far to go. Every step has a fixed scope and a written deliverable, so there are no surprises halfway through."
  />

  <Partnership />

  <ProductsSection />

  <ProcessTimeline />

  <FAQ items={faqs} heading="About the studio" />

  <CTA />
</Layout>
