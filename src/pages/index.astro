---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/site/Hero.astro";
import Doors from "@/components/site/Doors.astro";
import ServicesGrid from "@/components/site/ServicesGrid.astro";
import ProductsSection from "@/components/site/ProductsSection.astro";
import OfferLadder from "@/components/site/OfferLadder.astro";
import ProcessTimeline from "@/components/site/ProcessTimeline.astro";
import FAQ from "@/components/site/FAQ.astro";
import CTA from "@/components/site/CTA.astro";

const faqs = [
  {
    q: "What does an AI engineering studio do?",
    a: "We design, build, and run production AI systems: agents that do real work inside your operations, voice and retrieval systems, and AI features in products. We also help decide where AI is worth using, and where it is not.",
  },
  {
    q: "How is this different from a typical AI consultancy?",
    a: "We build the systems, not only the plan. Our work ships with evaluation, guardrails, and monitoring, and we hand over documentation your team can own. The engineers who scope the work are the ones who build it.",
  },
  {
    q: "Do you work with small businesses, or only large companies?",
    a: "Both, and startups too. Small and mid-sized businesses usually begin with a fixed-scope AI-Native Audit. Larger organisations typically need help taking pilots into production, with governance and security review.",
  },
  {
    q: "Where are you based?",
    a: "Toronto, Canada. We work with teams worldwide, remotely and by video.",
  },
];
---

<Layout title="AI engineering studio: become AI-native">
  <Hero />

  <Doors />

  <section class="border-t border-line py-20 lg:py-28">
    <div class="shell">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-xl">
          <span class="kicker">What we do</span>
          <h2 class="text-title mt-5 font-display font-semibold text-ink text-balance">
            Consulting that ends in working software.
          </h2>
        </div>
        <a href="/services" class="link-underline shrink-0 text-[15px]">All services</a>
      </div>

      <div class="mt-12">
        <ServicesGrid limit={6} />
      </div>
    </div>
  </section>

  <OfferLadder />

  <ProductsSection />

  <ProcessTimeline />

  <FAQ items={faqs} heading="About the studio" />

  <CTA />
</Layout>
